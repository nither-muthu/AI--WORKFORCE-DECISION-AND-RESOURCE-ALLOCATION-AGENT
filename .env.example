# Application Configuration
APP_NAME=AI Workforce Allocation System
APP_ENV=development
PORT=8000
FRONTEND_PORT=5173

# Database (Default: SQLite, can be swapped for PostgreSQL)
DATABASE_URL=sqlite:///./database/workforce.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/workforce_db

# Security
SECRET_KEY=hackathon-super-secret-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Configuration
MODEL_PATH=./ml/models/workforce_rf_model.joblib
